{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe_json": {
      "()": "app.observability.SafeJsonFormatter"
    }
  },
  "handlers": {
    "safe_stderr": {
      "class": "logging.StreamHandler",
      "formatter": "safe_json",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["safe_stderr"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["safe_stderr"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error.davi": {
      "handlers": ["safe_stderr"],
      "level": "INFO",
      "propagate": false
    }
  }
}
