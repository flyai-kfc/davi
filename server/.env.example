# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.  .env 는 gitignore된다.
# 서버만 키를 안다. 앱 APK에는 절대 키를 넣지 않는다 (SPEC.md §2, §7).

# 실행 프로필. 로컬·테스트는 development, 배포 환경은 production을 명시한다.
DAVI_ENV=development

# Gemini API 키
# --- LLM 공급자 ---
# gemini | openai | anthropic. 셋 다 같은 구조화 JSON 계약을 쓰므로 교체는 이 줄 하나다
# (app/llm_provider.py). 고른 공급자의 키만 있으면 되고, 없으면 기동 때 바로 실패한다.
DAVI_LLM_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 사용할 모델. **비우면 공급자 기본값**을 쓴다 — gemini-3.5-flash-lite / gpt-5.6-luna /
# claude-haiku-4-5. 셋 다 "짧은 JSON 하나를 빠르게"에 맞춘 저지연 등급이다. 공급자만 바꾸고
# 이 값을 안 고쳐서 엉뚱한 모델 id가 나가는 사고를 막으려고 비움을 기본으로 뒀다.
# 품질이 더 필요하면 여기서 올린다(예: gemini-3.6-flash, gpt-5.6-terra, claude-sonnet-5).
DAVI_MODEL=gemini-3.5-flash-lite

# Gemini thinking 토큰 상한(0 이상). thinking이 없는 모델(flash-lite 등)에는 보내도 조용히
# 무시된다. 낮을수록 빠르지만 판단이 얕아지고, 높을수록 느려진다 — next-step/slot-fill/
# app-resolution 세 호출부가 이 값 위에 각자 정상 응답 여유분을 얹어 maxOutputTokens를
# 정하므로(잘림 방지), 이 값만 바꾸면 셋 다 함께 바뀐다.
DAVI_GEMINI_THINKING_BUDGET=800

# OpenAI에서 thinking에 해당하는 값: none|low|medium|high|xhigh|max. 속도를 위해 낮게 둔다.
# none이면 reasoning 토큰 여유분도 얹지 않는다. Anthropic 경로는 thinking을 아예 보내지
# 않는다(짧은 JSON 하나에 지연만 늘어서다 — app/llm_provider.py 모듈 문서).
DAVI_OPENAI_REASONING_EFFORT=low

# 출력 토큰 상한 강제값. 0이면 공급자별로 자동 계산한다. 모델을 바꿨는데 응답이 잘리거나
# 너무 비쌀 때만 손댄다.
DAVI_MAX_OUTPUT_TOKENS=0

# 도그푸딩 기기에서만 전체 화면 트리 로그를 보존한다(SPEC §3). 그 외에는 메타만.
# 값은 앱 debug 빌드가 GuideSvc 로그 `dogfoodDeviceId=`로 찍는 16자 해시(콤마 구분).
# 비우면 아무 기기도 저장하지 않는다.
DAVI_DOGFOOD_DEVICE_IDS=

# raw 봉투 저장 위치(#41). 상대 경로는 server/ 루트 기준이며 gitignore된다.
# 영구 보존 — 자동 삭제가 없고 정리는 수동이다.
DAVI_DOGFOOD_RAW_DIR=.dogfood-raw

# 개발 편의: true면 키 없이도 뜨는 스텁 LLM으로 동작(테스트/오프라인).
# production에서는 반드시 false이고 DAVI_LLM_PROVIDER가 고른 공급자의 키가 있어야 한다.
DAVI_USE_STUB_LLM=true

# 2차 마스킹 우회(#203). masked/unmasked 가이드 품질 비교 실험 전용이며 **기본은 꺼짐**이다.
# true면 앱이 보낸 화면 label이 치환 없이 실제 모델까지 전달되고, raw 봉투 저장은 꺼진다.
# development + loopback 바인딩 + 개발 토큰 없음을 모두 만족할 때만 서버가 뜬다.
# 합성 데이터만 넣은 전용 테스트 기기에서만 쓴다. 절차는 app-android/DEVICE-E2E-RUN.md.
DAVI_DISABLE_PRIVACY_MASKING=false

# 공식 실행 스크립트의 bind 경계. 평소 로컬은 loopback이며 production도 loopback만 허용한다.
DAVI_BIND_HOST=127.0.0.1

# 공용 development endpoint 제한. 팀 전체 10회/60초가 기본이며 양수만 허용한다.
DAVI_DEV_RATE_LIMIT_REQUESTS=10
DAVI_DEV_RATE_LIMIT_WINDOW_SECONDS=60

# 공용 개발 접근 토큰은 이 파일이 아니라 저장소 밖 ~/.config/davi/shared-dev.env에만 둔다.
# 형식: DAVI_DEV_ACCESS_TOKEN=<32자 이상의 임의 토큰>, 파일 권한 600.

# --- 카카오 로그인 (POST /v1/auth/kakao) ---
# 둘 다 채워야 로그인 endpoint가 동작한다. 비어 있으면 SERVER 오류로 닫힌다.
# 카카오 개발자 콘솔의 앱 ID(숫자). REST API 키·네이티브 앱 키가 아니다 — 토큰의 발급처 검증용.
DAVI_KAKAO_APP_ID=0
# 세션 JWT 서명 비밀. 32자 이상 임의 문자열. 바꾸면 발급된 세션이 전부 무효화된다.
DAVI_AUTH_JWT_SECRET=
# 세션 토큰 수명(초). 기본 30일.
DAVI_AUTH_SESSION_TTL_SECONDS=2592000
# 로그인 endpoint 제한(모든 프로필). 전체 상한은 카카오 API 소모 총량을,
# 출처별 제한은 한 출처의 폭주로부터 정상 사용자를 지킨다. 모두 양수만 허용하고,
# 출처 창(PER_SOURCE_WINDOW)은 전체 창(WINDOW) 이하여야 한다 — 더 길면 전역 창이
# 갱신될 때마다 출처 키가 쌓여 메모리 상한 보장이 깨진다(기동 시 검증).
# 출처는 직접 연결 peer IP다 — 프록시 뒤에서는 uvicorn --proxy-headers +
# --forwarded-allow-ips로 신뢰 프록시가 재작성한 주소가 쓰인다.
DAVI_AUTH_RATE_LIMIT_REQUESTS=100
DAVI_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
DAVI_AUTH_RATE_LIMIT_PER_SOURCE_REQUESTS=10
DAVI_AUTH_RATE_LIMIT_PER_SOURCE_WINDOW_SECONDS=60
