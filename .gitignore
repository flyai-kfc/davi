# PoC codebase
reference/

# Ignore environment variables and node modules
.env
.env.*
node_modules/

# Python (server/, eval/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
eval/runs/
# 공용 development 서버 PID·일 단위 로그(#57)
server/.shared-dev/
# 도그푸딩 raw 봉투(#41) — 영구 보존, 커밋 금지
server/.dogfood-raw/
# Azure dev resource 이름은 환경별 값이다. 예시만 추적한다.
infra/azure/parameters.dev.json

# Android (app-android/)
*.iml
.gradle/
local.properties
app-android/build/
app-android/**/build/
# 실기기 E2E 상세 요청·응답 보고서 — 로컬 분석 전용, 공유·커밋 금지
app-android/build/reports/device-e2e-private/
.idea/
*.keystore
*.jks
# Gradle CLI 우회용 AF_UNIX 소켓 임시 폴더 (app-android/scripts/dev-install.ps1)
.gradle-afunix-tmp/
# JVM 크래시 덤프 (Gradle 데몬 죽을 때 생김)
hs_err_pid*.log
replay_pid*.log

# macOS Finder 부산물
.DS_Store
