#!/bin/sh
# 푸시 전 로컬 방어선. 하는 일은 둘이다.
#   ① main 직접 푸시를 막는다.
#   ② server/ 가 바뀐 푸시에 한해 CI와 같은 값싼 린트(ruff)를 먼저 돌린다.
#
# 왜 필요한가: 무료 조직 + private 저장소라 GitHub 브랜치 보호를 걸 수 없다
# (403 "Upgrade to GitHub Pro..."). 서버가 안 막아주니 각자 로컬에서 막는다.
# CONTRIBUTING.md "저장소 설정" 참고.
#
# **여기 없는 것은 훅이 대신 봐주지 않는다.** 앱 빌드는 로컬 4분대라 넣지 않았다 —
# --no-verify 가 습관이 되면 ①까지 같이 죽는다. 변경분 셀프리뷰는 사람이 한다
# (CONTRIBUTING.md "로컬 검사 (푸시 전)").
#
# **외부 도구에 기대지 않는다.** 판정이 awk·grep 같은 것에 걸리면 그게 없는 환경에서
# 훅이 조용히 통과한다 — 막으라고 있는 것이 fail-open 이 되는 방향이다.
#
# 설치:  git config core.hooksPath .githooks
# 우회:  git push --no-verify   (정말 필요할 때만)

PROTECTED="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"

# git 은 remote 이름과 URL을 인자로, 밀 ref 들을 stdin 으로 준다.
# 아래 루프의 `set --` 이 위치 인자를 덮으므로 **먼저** 받아 둔다.
push_remote=${1:-origin}

# stdin 은 한 번만 읽을 수 있는데 아래 검사가 git 을 다시 부른다. 먼저 통째로 받아 둔다.
REFS=$(cat)

# 밀리는 ref 를 한 번만 훑어 ①과 ②를 같이 판정한다.
# `for` 목록의 단어 분리는 전개 시점에 한 번 일어나므로 루프 안에서 IFS 를 바꿔도 안전하다.
server_touched=0
old_ifs=$IFS
IFS='
'
# `set -f`: 아래 `set --`의 단어 분리에는 pathname expansion도 같이 걸린다. ref 문법이
# glob 문자를 금지해 실무상 안 터지지만, 그 근거를 안 따져도 되게 막아 둔다.
set -f
for line in $REFS; do
    IFS=' '
    # shellcheck disable=SC2086  # 공백 구분 4필드를 일부러 쪼갠다
    set -- $line
    local_sha=$2
    remote_ref=$3
    remote_sha=$4

    # ── ① main 직접 푸시 거부 ───────────────────────────────────────────
    if [ "$remote_ref" = "$PROTECTED" ]; then
        IFS=$old_ifs
        echo "" >&2
        echo "  거부: main에 직접 푸시하지 않는다." >&2
        echo "" >&2
        echo "  feature 브랜치 -> PR -> 리뷰 1인 -> merge 로 진행한다." >&2
        echo "  브랜치명 규칙: <타입>/<범위>-<요약>   예) feat/server-completion-verify" >&2
        echo "" >&2
        echo "  지금 작업을 브랜치로 옮기려면:" >&2
        echo "    git switch -c feat/<범위>-<요약>" >&2
        echo "    git push -u origin HEAD" >&2
        echo "" >&2
        echo "  (의도적으로 넘기려면 git push --no-verify)" >&2
        echo "" >&2
        exit 1
    fi

    # ── ② server/ 가 바뀌었는지 ─────────────────────────────────────────
    # 브랜치 삭제 푸시는 볼 것이 없다.
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # 새 브랜치라 원격에 비교 대상이 없다. main 에서 갈라진 지점부터 본다.
        base=$(git merge-base "$local_sha" "$push_remote/main" 2>/dev/null) || base=""
    else
        base=$remote_sha
    fi

    # **비교에 실패하면 검사를 건너뛰지 않고 돌린다.** 20초를 더 쓸 뿐이고, 반대로
    # 건너뛰면 방어선이 조용히 사라진다. 원격 sha 가 로컬에 없는 경우가 실제로 있다 —
    # GitHub "Update branch" 로 갱신한 PR 브랜치에 force-push 할 때가 그렇다.
    # core.quotePath=false: 켜져 있으면 비ASCII 경로가 "server\355..." 로 나와 아래 판정을 빗나간다.
    if [ -n "$base" ] && changed=$(git -c core.quotePath=false diff --name-only "$base" "$local_sha" 2>/dev/null); then
        :
    else
        changed="server/"
    fi

    # **`eval/`은 일부러 뺐다.** CI의 eval 검사는 대상 파일 목록을 `ci.yml`에 하드코딩해
    # 두고 있어(`ruff check harness.py judge.py ...`) 훅이 그걸 복제하면 원본이 둘이 된다 —
    # 이 PR이 CLAUDE.md 쪽에서 막은 것과 같은 문제다. 목록을 한쪽으로 모은 뒤에 넣는다(#468).
    case "
$changed" in
        *"
server/"*) server_touched=1 ;;
    esac
done
IFS=$old_ifs
set +f

[ "$server_touched" -eq 1 ] || exit 0

# ── ② server 검사 ────────────────────────────────────────────────────
# **`ruff` 만 돈다. `pytest` 는 아직 안 넣는다.** `server/tests/test_shared_dev_scripts.py` 가
# `subprocess.run(["bash", ...])` 를 쓰는데 Windows 의 venv 파이썬은 Git Bash 의 bash 를 못 찾아
# exit 127 로 죽는다 — 이 훅과 무관한 기존 상태이고 CI(Linux)는 초록이다. 그대로 넣으면 Windows
# 개발자가 `server/` 를 고칠 때마다 막혀 `--no-verify` 가 습관이 되고, 그러면 ①까지 같이 죽는다.
# 앱 빌드를 뺀 것과 같은 논리다. 수트가 Windows 에서 초록이 된 뒤에 넣는다(#468).
if ! command -v ruff >/dev/null 2>&1; then
    echo "" >&2
    echo "  건너뜀: ruff 를 찾지 못해 server 검사를 생략한다." >&2
    echo "  (설치: pip install -r server/requirements-dev.txt)" >&2
    echo "" >&2
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
echo "" >&2
echo "  server/ 변경 감지 — ruff 를 먼저 돌린다. (넘기려면 --no-verify)" >&2
echo "" >&2

# **검사 대상은 미는 커밋이 아니라 지금 작업 트리다.** 사람이 손으로 돌리는 것과 같은
# 한계다 — 커밋 안 한 오류로 막힐 수도, 체크아웃한 것과 다른 브랜치를 밀면 엉뚱한 트리를
# 볼 수도 있다. 그걸 정확히 하려면 임시 체크아웃이 필요한데 훅이 질 값이 아니다.
if ! (
    cd "$repo_root/server" || exit 1
    ruff check . &&
    ruff format --check .
); then
    echo "" >&2
    echo "  거부: server 린트가 실패했다. 고치고 다시 민다." >&2
    echo "  (의도적으로 넘기려면 git push --no-verify)" >&2
    echo "" >&2
    exit 1
fi

exit 0
