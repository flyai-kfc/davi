<?xml version="1.0" encoding="utf-8"?>
<!--
  디버그 전용 매니페스트. main 매니페스트와 병합되며, 여기 있는 설정은 릴리스에 들어가지 않는다.
  로컬 개발 서버(평문 HTTP)에 붙기 위한 예외만 둔다. network_security_config.xml은
  build.gradle.kts가 검증된 debug 서버 host 하나를 넣어 생성한다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission
        android:name="com.davi.helper.permission.CONTROL_E2E"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.davi.helper.permission.CONTROL_E2E" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!--
          개발용 백업 화면(#123 이전 홈). 클래스가 debug 소스셋에만 있어 릴리스엔
          아예 포함되지 않는다. 기본 앱 아이콘은 제품 온보딩을 열어야 하므로 launcher로
          등록하지 않는다. 텍스트 목표 입력·안내 시작/중지가 필요할 때만 명시적 component로 연다:
          `adb shell am start -n com.davi.helper.debug/com.davi.helper.MainActivity`
          (앞은 applicationId라 .debug가 붙고 뒤는 namespace라 안 붙는다. 축약형
          `com.davi.helper.debug/.MainActivity`는 클래스를 com.davi.helper.debug.MainActivity로
          풀어 틀린다 — #58)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/main_backup_label"
            android:windowSoftInputMode="adjustResize" />
        <receiver
            android:name=".GuideE2eControlReceiver"
            android:exported="true"
            android:permission="com.davi.helper.permission.CONTROL_E2E">
            <intent-filter>
                <action android:name="com.davi.helper.e2e.START" />
                <action android:name="com.davi.helper.e2e.START_JOURNEY" />
                <action android:name="com.davi.helper.e2e.STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
