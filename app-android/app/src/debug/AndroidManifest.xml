<?xml version="1.0" encoding="utf-8"?>
<!--
  디버그 전용 매니페스트. main 매니페스트와 병합되며, 여기 있는 설정은 릴리스에 들어가지 않는다.
  로컬 개발 서버(평문 HTTP)에 붙기 위한 예외만 둔다. network_security_config.xml은
  build.gradle.kts가 검증된 debug 서버 host 하나를 넣어 생성한다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">
        <!--
          MA-1(docs/SCREENS.md) 미리보기 진입. 클래스가 debug 소스셋에만 있어 릴리스엔
          아예 포함되지 않는다. 기존 홈(MainActivity) 교체 시점은 팀 결정(#100).
        -->
        <activity
            android:name=".VoiceHomeActivity"
            android:exported="true"
            android:label="@string/voice_home_preview_label"
            android:theme="@style/Theme.Davi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
