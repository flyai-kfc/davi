<?xml version="1.0" encoding="utf-8"?>
<!--
  디버그 빌드에서만 **로컬 개발 서버로의 평문 HTTP**를 허용한다.

  targetSdk 28+ 부터 평문 통신이 기본 차단이라, 실기기에서 로컬 서버에 붙으면
  `CLEARTEXT communication to 127.0.0.1 not permitted by network security policy`로 막힌다
  (실측: SM-S921N / Android 16). 터널(https)로 붙을 땐 안 겪지만, USB로 붙은 기기를
  `adb reverse`로 붙이면 바로 이걸 만난다.

  이 파일은 `src/debug/`에만 있으므로 **릴리스 빌드는 평문이 계속 막혀 있다.**
  실제 배포에서 화면 데이터를 평문으로 보내는 일이 없어야 한다(SPEC §2).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- adb reverse로 붙은 호스트 PC -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- 에뮬레이터에서 본 호스트 PC (BuildConfig.SERVER_URL 기본값) -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
