<?xml version="1.0" encoding="utf-8"?>
<!--
  온보딩 화면. 시니어 대상이라 글자가 커지면 내용이 잘리기 쉬우므로 ScrollView로 감싼다
  (시스템 글꼴을 최대로 키운 기기에서 버튼이 화면 밖으로 나가는 것을 막는다).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/davi_spacing_xl">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textSize="@dimen/davi_type_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_xl"
            android:layout_marginBottom="@dimen/davi_spacing_xl"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onboarding_body"
            android:textSize="@dimen/davi_type_body_lg" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/davi_size_touch_target"
            android:text="@string/btn_open_accessibility"
            android:textSize="@dimen/davi_type_body_lg" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:minHeight="@dimen/davi_size_touch_target"
            android:text="@string/btn_open_overlay"
            android:textSize="@dimen/davi_type_body_lg" />

        <TextView
            android:id="@+id/goal_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_xl"
            android:labelFor="@+id/goal_input"
            android:text="@string/goal_label"
            android:textSize="@dimen/davi_type_body_lg"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/goal_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:hint="@string/goal_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:minHeight="@dimen/davi_size_touch_target"
            android:textSize="@dimen/davi_type_body_lg" />

        <Button
            android:id="@+id/btn_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:minHeight="@dimen/davi_size_touch_target"
            android:text="@string/btn_voice_input"
            android:textSize="@dimen/davi_type_body_lg" />

        <TextView
            android:id="@+id/voice_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/voice_idle"
            android:textSize="@dimen/davi_type_body_lg" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:minHeight="@dimen/davi_size_touch_target"
            android:text="@string/btn_start"
            android:textSize="@dimen/davi_type_body_lg" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:minHeight="@dimen/davi_size_touch_target"
            android:text="@string/btn_stop"
            android:textSize="@dimen/davi_type_body_lg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/guide_hint"
            android:textSize="@dimen/davi_type_body_lg" />

    </LinearLayout>

</ScrollView>
