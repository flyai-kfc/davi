<?xml version="1.0" encoding="utf-8"?>
<!--
  Cafe24 Ssurround 번들 (C1 개정, #174) — **다비가 말하는 자리 전용**.
  파일 하나(Bold)뿐이라 400·700 양쪽에 같은 파일을 물린다.

  **raw ttf를 @font/…로 바로 가리키면 안 된다.** 쓰는 스타일이 textStyle=bold라 700을
  찾는데, font-family 매핑이 없으면 시스템 서체로 떨어진다(실기기 실측 — 각진 글자가 나왔다).
  Pretendard가 같은 이유로 이 형식을 쓴다.

  한글 음절 11,172자를 모두 담고 있음을 확인했다(fontTools cmap). 다비 말은 서버가 만드는
  문장이라 드문 글자가 나오는데 커버리지가 100%라 두부가 뜨지 않는다. APK에 3.8MB를 더한다.

  라이선스 고지는 licenses/ 에 넣어야 한다(미완 — 아래 이슈 참고).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/cafe24_ssurround_bold"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/cafe24_ssurround_bold"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/cafe24_ssurround_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/cafe24_ssurround_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
