<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      카드 뒤 분홍 글로우(CardGlowView)의 뷰별 설정.
      값 자체의 근거는 dimens.xml의 davi_glow_card_* 주석에 있다.
    -->
    <!--
      점 셋의 크기. 기본값은 대화 화면 "잠시만요"의 시안 실측치(20/13/15)이고, 오버레이
      안내창은 창이 작아 훨씬 작게 준다. **뷰가 리소스를 직접 읽으면 두 곳이 한 값을
      나눠 쓰게 되어 한쪽을 줄이면 다른 쪽이 함께 줄어든다.**
    -->
    <declare-styleable name="LoadingDotsView">
        <attr name="daviDotSizeMax" format="dimension" />
        <attr name="daviDotSizeMin" format="dimension" />
        <attr name="daviDotSpacing" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CardGlowView">
        <!--
          같은 자리에 한 겹 더 얹을 때 그 겹의 불투명도(0~255, 기본 0 = 한 겹).

          **뷰별 속성인 것이 요점이다.** 이 보강은 글로우 토큰을 진하게 만드는 것이 아니라
          **시니어 카드의 불투명 분홍 채움을 보정**하는 것이라 카드마다 조건이 다르다.
          리소스에 두면 두 카드에 함께 걸려 #171에서 실기기 확인된 다비 글로우까지 바뀐다.
        -->
        <attr name="daviGlowBoostAlpha" format="integer" />
    </declare-styleable>
</resources>
