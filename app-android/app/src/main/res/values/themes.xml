<resources>
    <!--
      라이트 고정(B3, docs/DESIGN-CONVENTIONS.md). DayNight 상속은 다크 리소스 없이도
      시스템 다크에서 검증 안 된 M3 다크 팔레트를 적용해 B3와 충돌했다(#97 리뷰 → #100).
      다크 대응은 토큰에 다크 값을 설계하는 시점에 착수한다.
    -->
    <style name="Theme.Davi" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/davi_bg</item>
        <!-- Pretendard 전역 적용 (C1). textStyle=bold가 700 파일로 해석된다. -->
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
    </style>

    <!-- 타입 램프 (C2) — Figma davi/* 텍스트 스타일과 1:1 -->
    <style name="TextAppearance.Davi.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/davi_type_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/davi_text_primary</item>
    </style>
    <style name="TextAppearance.Davi.Subtitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/davi_type_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/davi_text_primary</item>
    </style>
    <style name="TextAppearance.Davi.BodyLg" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/davi_type_body_lg</item>
        <item name="android:textColor">@color/davi_text_primary</item>
    </style>
    <style name="TextAppearance.Davi.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/davi_type_body</item>
        <item name="android:textColor">@color/davi_text_primary</item>
    </style>
    <style name="TextAppearance.Davi.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/davi_type_caption</item>
        <item name="android:textColor">@color/davi_text_secondary</item>
    </style>

    <!-- 버튼 (E1 button, E2 눌림=state layer ripple) — Figma button 컴포넌트와 1:1 -->
    <style name="Widget.Davi.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/davi_size_touch_target</item>
        <item name="android:textSize">@dimen/davi_type_body_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="Widget.Davi.Button.Primary">
        <item name="android:background">@drawable/bg_davi_button_primary</item>
        <item name="android:textColor">@color/davi_button_on_primary</item>
    </style>
    <style name="Widget.Davi.Button.Secondary">
        <item name="android:background">@drawable/bg_davi_button_secondary</item>
        <item name="android:textColor">@color/davi_text_primary</item>
    </style>
</resources>
