<resources>
    <!--
      시니어 대상 기본값. sp는 시스템 글꼴 크기 설정을 따라간다(코드에서 px 계산 금지).
      터치 대상은 Android 권장 48dp보다 크게 잡는다.
    -->
    <dimen name="text_title">26sp</dimen>
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_button">20sp</dimen>
    <!-- 다른 앱 위에 뜨는 안내문. 본문보다 조금 크게. -->
    <dimen name="text_overlay_instruction">22sp</dimen>

    <dimen name="touch_target_min">56dp</dimen>
    <dimen name="spacing">24dp</dimen>
    <dimen name="spacing_small">12dp</dimen>

    <!-- 안내문 상자: 글자와 상자 사이(padding), 상자와 대상·화면 가장자리 사이(margin). -->
    <dimen name="overlay_instruction_padding">16dp</dimen>
    <dimen name="overlay_instruction_margin">20dp</dimen>

    <!-- 화면1(대기) 원형 음성 버튼. 시니어 터치 대상이라 touch_target_min보다 크게 잡는다. -->
    <dimen name="voice_button_size">140dp</dimen>

    <!--
      화면2(리스닝) "마이크 + 양옆 음파" 표시. 채팅 말풍선이 아니라 별도의 큰 상태
      그래픽이다 — 대화 메시지가 아니라 "지금 듣고 있다"는 상태 표시라 다비 말풍선에
      넣지 않는다(사용자 피드백).
    -->
    <dimen name="listening_wave_width">280dp</dimen>
    <dimen name="listening_wave_height">120dp</dimen>
    <dimen name="listening_mic_icon_size">56dp</dimen>

    <!--
      채팅형 말풍선 화면(리스닝·되묻기·최종확인 공통). 사용자 발화(echo)도 다비 질문과
      같은 크기로 — 시니어가 자기 말이 어떻게 인식됐는지 작은 글씨로 무시되면 안 된다.
    -->
    <dimen name="text_confirm_question">26sp</dimen>
    <!-- 리스닝 중 실시간 받아쓰기. 채팅형 화면에서 가장 크게 보여야 할 텍스트. -->
    <dimen name="text_transcript_large">30sp</dimen>
    <!-- X/O 원형 버튼. 시니어 터치 대상 기준을 지킨다. -->
    <dimen name="confirm_choice_button_size">88dp</dimen>
    <dimen name="confirm_choice_radius">16dp</dimen>

    <!-- 테두리 버튼("다시 말하기") 공통. -->
    <dimen name="field_border_width">1dp</dimen>
    <dimen name="field_radius">12dp</dimen>
    <dimen name="avatar_size">48dp</dimen>
    <dimen name="bubble_padding">16dp</dimen>
    <dimen name="bubble_max_width">560dp</dimen>
</resources>
