<resources>
    <!--
      시니어 대상 기본값. sp는 시스템 글꼴 크기 설정을 따라간다(코드에서 px 계산 금지).
      터치 대상은 Android 권장 48dp보다 크게 잡는다.
    -->
    <!--
      오버레이 전용 실측값 — 토큰 램프 밖 값이라 별도 유지한다(안내문 22sp는 원거리 가독 실측).
      GD 화면 재구현 시 램프 정합을 재검토한다(docs/SCREENS.md GD-1~3).
    -->
    <dimen name="text_overlay_instruction">22sp</dimen>
    <dimen name="overlay_instruction_padding">16dp</dimen>
    <dimen name="overlay_instruction_margin">20dp</dimen>
    <!-- 강조 테두리 두께. 기존 raw 12px가 검증 기기(3x)에서 4dp — 시인성 보존값. -->
    <dimen name="davi_overlay_highlight_stroke">4dp</dimen>

    <!--
      디자인 토큰(크기). 원본은 Figma Foundations primitives — 이름은 code syntax와 1:1.
      결정 기록: docs/DESIGN-CONVENTIONS.md (C2·D1·D2·D3).
    -->
    <dimen name="davi_type_title">28sp</dimen>
    <dimen name="davi_type_subtitle">24sp</dimen>
    <dimen name="davi_type_body_lg">20sp</dimen>
    <dimen name="davi_type_body">17sp</dimen>
    <dimen name="davi_type_caption">14sp</dimen>
    <dimen name="davi_spacing_xs">4dp</dimen>
    <dimen name="davi_spacing_sm">8dp</dimen>
    <dimen name="davi_spacing_md">12dp</dimen>
    <dimen name="davi_spacing_lg">16dp</dimen>
    <dimen name="davi_spacing_xl">24dp</dimen>
    <dimen name="davi_radius_sm">8dp</dimen>
    <dimen name="davi_radius_md">12dp</dimen>
    <dimen name="davi_radius_lg">16dp</dimen>
    <dimen name="davi_size_touch_target">56dp</dimen>

    <!-- 컴포넌트 고정 크기 (Figma Components 실측) -->
    <dimen name="davi_mic_button_size">130dp</dimen>
    <dimen name="davi_mic_button_stroke">4dp</dimen>
    <dimen name="davi_mic_button_padding">40dp</dimen>
    <dimen name="davi_mic_button_elevation">4dp</dimen>
    <dimen name="davi_button_stroke">1.5dp</dimen>
    <dimen name="davi_button_padding_h">20dp</dimen>
    <dimen name="davi_button_elevation">2dp</dimen>
    <!-- chip/confirm-pair (임시 디자인 실측 — 확정 시 재검토) -->
    <dimen name="davi_confirm_chip_width">96dp</dimen>
    <dimen name="davi_logo_size">72dp</dimen>
    <dimen name="davi_utterance_card_min_height">120dp</dimen>
    <!--
      질문 카드 높이 상한. 검증 기기(1080×2340) 기준으로 로고·발화 카드·바닥 컨트롤을 뺀
      잔여에서 잡았다. 상한이 가용 높이보다 크면 부모가 카드를 잘라 내부 스크롤이 닿지 않는
      영역이 생기는데, **더 낮은 화면에서 그렇게 될 수 있음을 알고 둔 임시치다**(PR #125 리뷰).
      화면 높이로 상한을 다시 묶는 계산은 넣지 않았다 — 카드·컨트롤 크기 자체가 확정 디자인에서
      다시 잡히므로 그 계산도 함께 폐기된다. 값과 "상태별로 다르다"는 동작 모두 그때 정한다.
    -->
    <dimen name="davi_question_card_max_height">220dp</dimen>
    <!-- 최종 확인은 발화 카드가 숨어 세로 여유가 가장 크다 — 승인 대상을 넓은 창으로 읽힌다. -->
    <dimen name="davi_question_card_max_height_confirm">400dp</dimen>
    <!-- 바닥 고정 컨트롤(마이크·확인쌍)이 차지하는 높이. 위 열은 이만큼을 비워 둔다. -->
    <dimen name="davi_conversation_control_reserve">178dp</dimen>
</resources>
