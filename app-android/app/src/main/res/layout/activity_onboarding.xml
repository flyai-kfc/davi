<?xml version="1.0" encoding="utf-8"?>
<!--
  온보딩(권한 안내). 문구는 기존 것을 준용 — 확정은 #29. 화면 디자인은 아직 와이어프레임에
  없어 기존 개발 화면(activity_main)의 권한부만 옮겼다.
  폼형 화면이라 글자 확대 대비 루트 스크롤 컨벤션을 유지한다.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/davi_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/davi_spacing_xl">

        <TextView
            android:id="@+id/onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textAppearance="@style/TextAppearance.Davi.Title" />

        <TextView
            android:id="@+id/onboarding_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_xl"
            android:layout_marginBottom="@dimen/davi_spacing_xl"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onboarding_body"
            android:textAppearance="@style/TextAppearance.Davi.BodyLg" />

        <Button
            android:id="@+id/btn_accessibility"
            style="@style/Widget.Davi.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_accessibility" />

        <Button
            android:id="@+id/btn_overlay"
            style="@style/Widget.Davi.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_spacing_md"
            android:text="@string/btn_open_overlay" />
    </LinearLayout>
</ScrollView>
