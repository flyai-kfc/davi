<?xml version="1.0" encoding="utf-8"?>
<!--
  ON-2 권한 설정(#236). 시안 SSoT › SCREENS › 온보딩 v2 › 「온보딩 3 — 앱 권한 설정」.

  **동작은 이 파일이 정하지 않는다** — 권한 두 개 감시 · 설정 딥링크 · 둘 다 켜지면 자동
  진행 · 밖에서 꺼지면 복귀는 전부 [OnboardingActivity]에 이미 있다. 여기는 모양만 바꾼다.

  폼형 화면이라 **루트 스크롤을 유지한다** — 글자 배율을 키우면 세로가 모자란다.
  배경 메시는 스크롤 바깥에 둔다. 안에 넣으면 스크롤과 함께 밀려 올라간다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      대화 화면이 쓰는 그 뷰다(2026-08-18 결정: 앱의 모든 배경은 같은 분홍 메시).

      **인셋 층 바깥에 둔다** — 안에 넣으면 시스템 바 마진이 메시에도 걸려 메시가 화면 끝까지
      못 가고, 그 바깥으로 windowBackground(davi_bg #FFFFFF)가 흰 띠로 드러난다.
      바뀌기 전에는 루트 배경이 davi_bg라 같은 색이어서 안 보였다(PR #237 리뷰).
      대화 화면이 conversation_root / conversation_insets로 층을 가른 것과 같은 구조다.
    -->
    <com.davi.helper.MeshBackgroundView
        android:id="@+id/mesh_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- 시스템 바 인셋을 받는 층. OnboardingActivity가 이 뷰에 마진을 준다. -->
    <FrameLayout
        android:id="@+id/onboarding_insets"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/davi_spacing_xl">

            <!--
              카드. **높이가 내용보다 크다**(시안 188 고정, 내용 124) — 오토레이아웃 정렬이
              CENTER라 위아래로 32씩 남는다. 그래서 **최소 높이**로 두고 내용을 세로 가운데 둔다.
              고정 높이로 박으면 글자 배율을 키웠을 때 카드가 못 커져 내용이 잘린다.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/davi_onboarding_card_min_height"
                android:layout_marginStart="@dimen/davi_onboarding_card_margin_h"
                android:layout_marginEnd="@dimen/davi_onboarding_card_margin_h"
                android:layout_marginTop="@dimen/davi_onboarding_card_margin_top"
                android:paddingStart="@dimen/davi_onboarding_card_padding_h"
                android:paddingEnd="@dimen/davi_onboarding_card_padding_h"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_davi_onboarding_card">

                <!--
                  일러스트 슬롯과 톱니를 **하나로 묶는다**. 시안에서는 둘이 컴포넌트로 안
                  묶여 있어 카드를 옮기면 톱니가 안 따라왔다(디자인 담당 지적).
                  회색 원은 자리표시라 스크린리더에서 뺀다 — 뜻을 지닌 그림이 아니다.
                -->
                <FrameLayout
                    android:layout_width="@dimen/davi_onboarding_slot_size"
                    android:layout_height="@dimen/davi_onboarding_slot_size"
                    android:background="@drawable/bg_davi_onboarding_slot"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="@dimen/davi_onboarding_icon_size"
                        android:layout_height="@dimen/davi_onboarding_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_davi_gear"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/onboarding_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/davi_onboarding_card_gap"
                    android:gravity="center"
                    android:text="@string/onboarding_title"
                    android:textAppearance="@style/TextAppearance.Davi.OnboardingTitle" />

                <TextView
                    android:id="@+id/onboarding_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/davi_onboarding_card_gap"
                    android:gravity="center"
                    android:text="@string/onboarding_permission_note"
                    android:textAppearance="@style/TextAppearance.Davi.OnboardingBody" />
            </LinearLayout>

            <!--
              **보조 스타일이다**(시안). 원래 근거는 "두 권한이 동등하게 필수라 하나를 주 버튼으로
              올리면 이것만 누르면 된다로 읽힌다"였는데(2026-08-18 디자인 담당 합의, #236),
              **#212가 오버레이 권한을 걷어내며 버튼이 하나가 되어 그 근거가 사라졌다.**
              스타일을 바꾸는 것은 시각 판단이라 여기서 건드리지 않는다 — 재판정은 Figma 트랙
              (`docs/SCREENS.md` ON-2의 [미결]).

              **바탕(카드)과 버튼이 둘 다 #F4F4F6**이라 둘을 가르는 것은 테두리 1.5와 그림자뿐이다.
              실기기에서 버튼으로 안 읽히면 여기가 첫 번째로 볼 값이다.

              **높이는 고정이 아니라 최소값이다.** 시안 60(→72dp)으로 박았더니 글자 배율 2.0에서
              라벨이 두 줄이 되면서 아래가 잘렸다(실기기, 2026-08-18). 시니어 대상이라 글자를
              줄이는 쪽은 답이 아니다 — 상자가 커져야 한다.
            -->
            <Button
                android:id="@+id/btn_accessibility"
                style="@style/Widget.Davi.OnboardingButton"
                android:layout_width="@dimen/davi_onboarding_button_width"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/davi_onboarding_button_min_height"
                android:layout_marginTop="@dimen/davi_onboarding_button_margin_top"
                android:text="@string/btn_open_accessibility" />

            <!-- 「다음」 버튼이 없다 — 권한이 켜지면 자동으로 넘어간다. 그 규칙을 말하는 문구다. -->
            <TextView
                android:id="@+id/onboarding_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/davi_onboarding_card_margin_h"
                android:layout_marginEnd="@dimen/davi_onboarding_card_margin_h"
                android:layout_marginTop="@dimen/davi_onboarding_hint_margin_top"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onboarding_permission_hint"
                android:textAppearance="@style/TextAppearance.Davi.OnboardingHint" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
</FrameLayout>
