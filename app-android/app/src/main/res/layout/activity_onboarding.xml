<?xml version="1.0" encoding="utf-8"?>
<!--
  온보딩(권한 안내). 문구는 기존 것을 준용 — 확정은 #29. 화면 디자인은 아직 와이어프레임에
  없어 기존 개발 화면(activity_main)의 권한부만 옮겼다.
  폼형 화면이라 글자 확대 대비 루트 스크롤 컨벤션을 유지한다.

  **화면 하나에 면이 둘이다**(#227). 권한 면이 기본이고, 접근성 버튼을 누르면 고지·동의 면으로
  바뀐다. 새 Activity가 아니라 같은 화면의 상태인 이유는 두 가지다 — Figma 파이프라인상
  새 화면은 와이어프레임 원본이 있어야 하고(`docs/DESIGN-CONVENTIONS.md`), 여기서 뒤로가기는
  "고지를 접는다"이지 "온보딩을 떠난다"가 아니다.

  **모달이 아니라 면인 이유**: 메인 10의 확인 모달(`bg_davi_dialog`)은 높이가 내용에 맞춰
  가운데 뜨고 스크롤이 없다. 고지 문구는 규정상 짧게 줄일 수 없어 글꼴 배율 2.0x(C4)에서
  넘친다. 스크롤되는 전체 면이라야 배율 보장을 지킨다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/davi_bg">

    <ScrollView
        android:id="@+id/onboarding_permission_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/davi_spacing_xl">

            <TextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_title"
                android:textAppearance="@style/TextAppearance.Davi.Title" />

            <TextView
                android:id="@+id/onboarding_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_xl"
                android:layout_marginBottom="@dimen/davi_spacing_xl"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onboarding_body"
                android:textAppearance="@style/TextAppearance.Davi.BodyLg" />

            <!--
              **이 버튼은 이제 설정으로 바로 가지 않는다**(#227). 고지·동의 면을 먼저 띄우고,
              거기 주 버튼이 설정으로 보낸다. 라벨을 그대로 둔 이유는 목적지가 여전히 접근성
              설정이고, 그 사이에 한 걸음이 끼는 것을 고지 면의 주 버튼("동의하고 설정 열기")이
              받아 주기 때문이다.
            -->
            <Button
                android:id="@+id/btn_accessibility"
                style="@style/Widget.Davi.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_open_accessibility" />

            <Button
                android:id="@+id/btn_overlay"
                style="@style/Widget.Davi.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_md"
                android:text="@string/btn_open_overlay" />
        </LinearLayout>
    </ScrollView>

    <!--
      접근성 고지·동의 면(#227). 권한 면 위를 덮는다 — 스크림이 아니라 불투명 배경이라
      뒤가 비치지 않는다. 뒤 화면의 버튼이 눌리지 않도록 clickable을 켠다.
    -->
    <ScrollView
        android:id="@+id/onboarding_notice_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/davi_bg"
        android:clickable="true"
        android:focusable="true"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/davi_spacing_xl">

            <TextView
                android:id="@+id/notice_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/a11y_notice_title"
                android:textAppearance="@style/TextAppearance.Davi.Title" />

            <TextView
                android:id="@+id/notice_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_lg"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/a11y_notice_lead"
                android:textAppearance="@style/TextAppearance.Davi.BodyLg" />

            <TextView
                android:id="@+id/notice_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_lg"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/a11y_notice_points"
                android:textAppearance="@style/TextAppearance.Davi.BodyLg" />

            <!--
              전문 펼침. 세컨더리 버튼을 쓰는 이유는 D1(터치 타깃 56dp)을 스타일이 이미
              보장해서다 — 밑줄 텍스트로 두면 배율에 따라 타깃이 56 아래로 내려간다.
            -->
            <Button
                android:id="@+id/btn_notice_detail"
                style="@style/Widget.Davi.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_lg"
                android:text="@string/btn_a11y_notice_more" />

            <TextView
                android:id="@+id/notice_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_lg"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/a11y_notice_detail"
                android:textAppearance="@style/TextAppearance.Davi.Body"
                android:visibility="gone" />

            <!--
              동의가 주 버튼이고 거절이 세컨더리다. 거절이 **있어야** 한다 — 동의 말고 길이
              없으면 규정이 말하는 "동의"가 아니다. 거절은 권한 면으로 되돌릴 뿐 앱을 막지
              않는다(접근성 없이는 안내가 안 되므로 온보딩에 그대로 머문다).
            -->
            <Button
                android:id="@+id/btn_notice_agree"
                style="@style/Widget.Davi.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_xl"
                android:text="@string/btn_a11y_notice_agree" />

            <Button
                android:id="@+id/btn_notice_later"
                style="@style/Widget.Davi.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/davi_spacing_md"
                android:text="@string/btn_a11y_notice_later" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
