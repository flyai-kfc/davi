<?xml version="1.0" encoding="utf-8"?>
<!--
  오버레이 확인쌍 `v2/confirm-pair`(#178) — GD-3 완료 확인 · GD-4 종료 확인.

  **네 번째 확인쌍 컴포넌트다.** 시안이 화면마다 따로 잡았다.

    메인 7   v2/button/pair       가로 캡슐 r36   흰/빨강
    메인 9   세로 버튼쌍           r14            흰/빨강
    메인 10  chip/confirm-pair    88x56 r12      빨강 #C62828 / 초록 #2E7D32 · 아이콘만
    여기     v2/confirm-pair      56 높이 캡슐    #A50014 / #1B5E20 · 아이콘만

  **라벨을 쓰지 않는다.** ×/○ 두 그림만으로 뜻이 서고, 글자를 얹으면 같은 말을
  본문과 버튼이 두 번 하게 된다(2026-08-18 결정). 뜻은 화면마다 다르므로
  `contentDescription`만 ControlOverlay가 상태에 따라 갈아 끼운다.

  폭은 절대치(236)를 쓰지 않고 창을 따른다 — 창이 화면 폭을 따르므로 같은 규칙이다.
  아래 패딩은 배경의 그림자 offset만큼이다. 채움이 그만큼 짧아서, 안 주면 아이콘이
  보이는 상자 안에서 처져 보인다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <ImageButton
        android:id="@+id/btn_confirm_reject"
        android:layout_width="0dp"
        android:layout_height="@dimen/davi_overlay_confirm_height"
        android:layout_weight="1"
        android:background="@drawable/bg_davi_overlay_confirm_reject"
        android:src="@drawable/ic_davi_x"
        android:scaleType="centerInside"
        android:paddingBottom="@dimen/davi_overlay_confirm_shadow_y" />

    <Space
        android:layout_width="@dimen/davi_overlay_confirm_gap"
        android:layout_height="1dp" />

    <ImageButton
        android:id="@+id/btn_confirm_accept"
        android:layout_width="0dp"
        android:layout_height="@dimen/davi_overlay_confirm_height"
        android:layout_weight="1"
        android:background="@drawable/bg_davi_overlay_confirm_accept"
        android:src="@drawable/ic_davi_circle"
        android:scaleType="centerInside"
        android:paddingBottom="@dimen/davi_overlay_confirm_shadow_y" />
</LinearLayout>
