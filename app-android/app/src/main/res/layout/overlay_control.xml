<?xml version="1.0" encoding="utf-8"?>
<!--
  조작 오버레이의 내용(#126). 창 자체가 안내창 크기로 잡히므로 여기서는 자리를 정하지 않는다 —
  안내창은 창을 꽉 채우고, 칩은 GuideBoxLayout이 상자 바닥에 비워 둔 컨트롤 행에 앉는다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.davi.helper.GuideBoxView
        android:id="@+id/guide_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      android.widget.Button을 온전한 이름으로 쓴다. 짧은 이름 <Button>은 Material 테마의
      인플레이터가 MaterialButton으로 바꿔치기하고, 그러면 backgroundTint가 커스텀 배경을
      덮는다(#123 실기기 실측 — themes.xml 주석). 여기는 Activity가 아니라 그 인플레이터가
      없지만, 이름으로 못박아 두면 나중에 붙어도 안 깨진다.
    -->
    <android.widget.Button
        android:id="@+id/btn_stop_chip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/davi_size_touch_target"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/overlay_instruction_padding"
        android:layout_marginBottom="@dimen/overlay_instruction_padding"
        android:background="@drawable/bg_davi_chip_danger"
        android:drawableStart="@drawable/ic_davi_x"
        android:drawablePadding="@dimen/davi_spacing_sm"
        android:paddingStart="@dimen/davi_button_padding_h"
        android:paddingEnd="@dimen/davi_button_padding_h"
        android:stateListAnimator="@null"
        android:text="@string/overlay_stop_chip"
        android:textAllCaps="false"
        android:textColor="@color/davi_button_on_primary"
        android:textSize="@dimen/davi_type_body" />

</FrameLayout>
