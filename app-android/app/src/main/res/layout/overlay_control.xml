<?xml version="1.0" encoding="utf-8"?>
<!--
  조작 오버레이의 내용(#126). 창 자체가 안내창 크기로 잡히므로 여기서는 자리를 정하지 않는다 —
  안내창은 창을 꽉 채우고, 칩은 GuideBoxLayout이 상자 바닥에 비워 둔 컨트롤 행에 앉는다.

  컨트롤 행에 앉는 것은 **둘 중 하나**다(#139) — 평소에는 중지 칩, 완료 확인(GD-3) 중에는
  확인쌍. 확인 중에 중지 칩을 함께 두지 않는 이유는 화면 명세 GD-3의 구성이 확인쌍뿐이고,
  칩 셋이 한 행에 들어가면 좁은 화면에서 겹치기 때문이다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.davi.helper.GuideBoxView
        android:id="@+id/guide_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      종료 X(v2, #178). 구 버전의 사각 "X 그만 볼래요" 칩을 대체한다.

      **창의 오른쪽 위 일부가 X 영역이다.** 창 위에 얹은 별개 원이 아니다 — 흰 곡면은
      [GuideBoxView]가 창의 일부로 그리고(모서리에 물려 잘린다), 여기 있는 것은 그 자리를
      받는 **터치 대상과 X 글리프뿐**이다. 배경을 주면 창 위에 원이 하나 더 얹혀 글자를 덮는다.

      배경은 투명이지만 **눌림 리플은 foreground로 남긴다** — 면을 창이 그리므로 배경을
      쓸 수 없는데, 리플까지 없으면 누른 게 먹었는지 알 방법이 없다(PR #229 리뷰).

      android.widget.Button을 온전한 이름으로 쓴다 — 짧은 이름은 Material 인플레이터가
      MaterialButton으로 바꿔치기하고 backgroundTint가 커스텀 배경을 덮는다(#123 실측).
    -->
    <android.widget.ImageButton
        android:id="@+id/btn_stop_chip"
        android:layout_width="@dimen/davi_overlay_close_size"
        android:layout_height="@dimen/davi_overlay_close_size"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/overlay_stop_chip" />

    <!--
      완료 확인(GD-3)의 ×아직요/○됐어요. contentDescription은 이 레이아웃이 대화 화면용으로
      쓰이는 값을 갖고 있으므로 ControlOverlay가 오버레이 문구로 덮는다 — 그대로 두면
      TalkBack이 "이대로 안내 시작"을 읽는다.
    -->
    <!--
      **폭은 match_parent여야 한다.** wrap_content로 두면 안의 버튼이 `0dp + weight`라
      폭이 거의 0으로 접히고 56dp 높이만 남아 세로 막대처럼 보인다(2026-08-18 실기기).
    -->
    <include
        android:id="@+id/confirm_pair"
        layout="@layout/view_davi_overlay_confirm_pair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/davi_overlay_confirm_inset"
        android:layout_marginEnd="@dimen/davi_overlay_confirm_inset"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/overlay_instruction_padding"
        android:visibility="gone" />

    <!--
      읽는 중 점 셋(GD-1). 대화 화면 "잠시만요"와 **같은 뷰·같은 리듬**이다 — 두 곳이
      따로 뛰면 같은 기다림이 다른 일처럼 보인다. 문구 아래에 놓는 것도 메인 6 시안과 같다.

      확인쌍과 같은 자리(창 바닥)를 쓰지만 겹치지 않는다 — 읽는 중과 확인 대기는
      배타적이다(ReadingBorder.isReading).
    -->
    <com.davi.helper.LoadingDotsView
        android:id="@+id/reading_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/davi_overlay_window_padding_v"
        android:visibility="gone"
        app:daviDotSizeMax="@dimen/davi_overlay_dot_size_max"
        app:daviDotSizeMin="@dimen/davi_overlay_dot_size_min"
        app:daviDotSpacing="@dimen/davi_overlay_dot_spacing" />

</FrameLayout>
