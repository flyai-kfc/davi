<?xml version="1.0" encoding="utf-8"?>
<!-- #316: 서버가 한 번에 준 최대 세 보기와 항상 열려 있는 직접 말하기. 최대 네 버튼이다. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/davi_spacing_sm">

        <TextView
            android:id="@+id/question_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/davi_clarification_button_gap"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Davi.Body"
            android:textColor="@color/davi_text_secondary" />

        <Button
            android:id="@+id/btn_option_1"
            style="@style/Widget.Davi.Clarification.Option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_option_2"
            style="@style/Widget.Davi.Clarification.Option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_clarification_button_gap" />

        <Button
            android:id="@+id/btn_option_3"
            style="@style/Widget.Davi.Clarification.Option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_clarification_button_gap" />

        <Button
            android:id="@+id/btn_direct_speak"
            style="@style/Widget.Davi.Clarification.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/davi_clarification_button_gap"
            android:text="@string/clarification_direct_speak" />
    </LinearLayout>
</ScrollView>
