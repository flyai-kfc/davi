                android:id="@+id/direct_speak_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical|start"
                android:paddingStart="@dimen/davi_choice_label_inset_icon"
                android:paddingEnd="@dimen/davi_shortcut_inset"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/clarification_direct_speak"
                android:textAppearance="@style/TextAppearance.Davi.ChoiceLabel.OnPrimary" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
