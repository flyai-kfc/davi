<?xml version="1.0" encoding="utf-8"?>
<!--
  ON-1.5 고지 카드(#389) — 제3자 정보 · 수집하지 않는 것 · 제외 불가 셋이 이 레이아웃을
  공유한다. **체크박스가 없다** — strings.xml 주석 그대로 "동의 항목이 아니라 고지"라
  view_davi_consent_item.xml과 다른 파일로 뗐다(체크 토글 카드에 체크 없는 예외를
  끼워 넣으면 그 파일을 읽는 다음 사람이 "왜 이것만 안 되나"를 다시 찾아야 한다).

  **접혀서 시작한다**(핸드오프 "접힌 카드를 제안"). 제목 또는 하단 토글 텍스트를 누르면
  펼쳐진다 — 열림 라벨은 항목마다 다르지만(예: consent_third_party_more) 닫힘은
  전부 consent_detail_close로 통일한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_davi_consent_card"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/davi_consent_card_padding_h"
    android:paddingEnd="@dimen/davi_consent_card_padding_h"
    android:paddingTop="@dimen/davi_consent_card_padding_top"
    android:paddingBottom="@dimen/davi_consent_card_padding_bottom">

    <!--
      **제목은 Pretendard다** — 화면 제목·부제가 Cafe24인 것과 갈린다(2026-08-24 시안 확인).
      고지는 다비가 건네는 말이 아니라 읽어야 하는 문서라 C1의 「다비가 입으로 하는 말」에
      들지 않는다. 테마 기본이 Pretendard라 여기에 따로 적지 않는다 —
      **`fontFamily`를 더하지 말 것.**
    -->
    <TextView
        android:id="@+id/consent_notice_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Davi.ConsentItemLabel" />

    <!-- 전문. 위 항목 카드와 같은 이유로 토글에서 떼지는 않는다 — 고지 카드는 체크가 없다. -->
    <TextView
        android:id="@+id/consent_notice_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/davi_consent_label_summary_gap"
        android:lineSpacingMultiplier="1.3"
        android:textAppearance="@style/TextAppearance.Davi.Caption"
        android:textColor="@color/davi_text_primary"
        android:visibility="gone" />

    <!-- textAppearance만으로는 Cafe24가 안 걸린다 — view_davi_consent_item.xml의 같은 주석. -->
    <TextView
        android:id="@+id/consent_notice_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/davi_consent_summary_detail_gap"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="@dimen/davi_consent_view_button_min_height"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Davi.ConsentViewButton"
        android:fontFamily="@font/cafe24_ssurround"
        app:fontFamily="@font/cafe24_ssurround" />
</LinearLayout>
