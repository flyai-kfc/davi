<?xml version="1.0" encoding="utf-8"?>
<!--
  ON-2 권한 버튼(#236). 시안 `v2/button` type=secondary 240×60 r12 —
  채움 `#F4F4F6` · 테두리 `#D9D9D9` 1.5 · 그림자 `#000000` 30% y3 b4.

  **카드와 같은 채움이다.** 바탕(카드 #F4F4F6)과 버튼이 같은 색이라 둘을 가르는 것은
  테두리와 그림자뿐이다 — 실기기에서 "버튼으로 읽히는지"를 확인 항목에 두었다(#236).

  그림자는 blur 없는 근사다(단색 도형을 아래로 민다) — 카드·확인쌍과 같은 사정이다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed">
    <item>
        <layer-list>
            <item
                android:top="@dimen/davi_onboarding_button_shadow_y"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_onboarding_button_shadow" />
                    <corners android:radius="@dimen/davi_radius_md" />
                </shape>
            </item>
            <item android:bottom="@dimen/davi_onboarding_button_shadow_y">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_surface" />
                    <corners android:radius="@dimen/davi_radius_md" />
                    <stroke
                        android:width="@dimen/davi_onboarding_button_stroke"
                        android:color="@color/davi_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
