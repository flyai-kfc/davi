<?xml version="1.0" encoding="utf-8"?>
<!--
  ON-1.5 항목 카드(#389). 카드 전체가 체크 토글이라 ripple을 카드 자신에 준다 — 안쪽
  체크박스는 장식이고 클릭 대상이 아니다(터치 영역을 카드 전체로 넓히는 결정, 핸드오프
  "체크박스 28은 D1 미달, 카드 전체 탭으로 푼다").

  ON-2 카드와 같은 값(#F4F4F6, 테두리·그림자 없음) — 화면 바탕(분홍 메시) 위 흰 계열
  서피스라는 같은 역할이라 새로 만들지 않는다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed_on_light">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/davi_surface" />
            <corners android:radius="@dimen/davi_consent_card_radius" />
        </shape>
    </item>
</ripple>
