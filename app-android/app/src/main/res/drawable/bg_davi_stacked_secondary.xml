<?xml version="1.0" encoding="utf-8"?>
<!--
  메인 9 **보조** 버튼 배경("기존 안내 이어서하기", #197).
  흰 채움 + 빨강 테두리 — 메인 7 보조와 같은 계열이고, v2/button 마스터의 회색 secondary가
  아니다. 그림자는 없다(시안이 주 버튼에만 줬다).

  테두리는 시안 INSIDE 2인데 Android <stroke>는 경계선 중앙 정렬이라 1dp가 밖으로 나간다 —
  보정 복잡도에 비해 얻는 게 작아 그대로 둔다(davi_card_border_width 주석과 같은 사정).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/davi_button_on_primary" />
            <stroke
                android:width="@dimen/davi_button_pair_stroke"
                android:color="@color/davi_button_primary" />
            <corners android:radius="@dimen/davi_stacked_button_radius" />
        </shape>
    </item>
</ripple>
