<?xml version="1.0" encoding="utf-8"?>
<!--
  MA-3 종료 ✕ 안의 표시(#374). 시안 12x12 w3.

  **뷰포트를 렌더 크기와 1:1로 둔다** — 다르면 획이 따라 늘어난다(PR #351에서 셰브런이
  뷰포트 8x20을 9.6x24 뷰에 그리며 2 -> 2.4dp가 된 그 함정). 크기 12는 객체라 x1.2 = 14.4,
  **획 3은 선이라 1:1**이다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="14.4dp"
    android:height="14.4dp"
    android:viewportWidth="14.4"
    android:viewportHeight="14.4">
    <path
        android:pathData="M2.4,2.4 L12,12"
        android:strokeColor="@color/davi_button_on_primary"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,2.4 L2.4,12"
        android:strokeColor="@color/davi_button_on_primary"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
