<?xml version="1.0" encoding="utf-8"?>
<!--
  MA-4 확인 버튼 (3)「아니요」 배경(#348). `color/surface`(#F4F4F6) 채움 +
  `color/border/quiet` 테두리 w2 · r12. 그림자 없음.

  **「눌러도 되지만 우리가 권하진 않는 것」**의 모양이다. (1)(2)와 채움·테두리 둘 다 갈려
  같은 줄에서도 성격이 읽힌다. **「비활성」으로 읽지 말 것** — 실제로 누를 수 있다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed_on_light">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/davi_surface" />
            <stroke
                android:width="@dimen/davi_confirm_choice_stroke"
                android:color="@color/davi_border_quiet" />
            <corners android:radius="@dimen/davi_confirm_choice_radius" />
        </shape>
    </item>
</ripple>
