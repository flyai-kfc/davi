<?xml version="1.0" encoding="utf-8"?>
<!--
  메인 9 **주** 버튼 배경("안내 종료", #197). 시안 `v2/button` 마스터 240x60 r12.

  메인 7의 캡슐쌍(bg_davi_button_pair_primary)과 **다른 컴포넌트다** — 저쪽은 r36 완전
  캡슐이고 여기는 r14 둥근 사각형이며 그림자 값도 다르다(#59000D 28% vs 검정 30%).

  **그림자는 blur 없는 근사다.** 단색 도형을 y만큼 아래로 밀고 채움을 그만큼 위로 들인다 —
  색 있는/번지는 그림자를 drawable로 못 만드는 사정은 카드·메인 7과 같다.
  채움이 offset만큼 짧아지지만 터치 영역은 뷰 크기 그대로다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed">
    <item>
        <layer-list>
            <item
                android:top="@dimen/davi_button_pair_shadow_offset_y"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_stacked_button_shadow" />
                    <corners android:radius="@dimen/davi_stacked_button_radius" />
                </shape>
            </item>
            <item android:bottom="@dimen/davi_button_pair_shadow_offset_y">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_button_primary" />
                    <corners android:radius="@dimen/davi_stacked_button_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
