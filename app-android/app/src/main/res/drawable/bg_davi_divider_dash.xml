<?xml version="1.0" encoding="utf-8"?>
<!--
  MA-4 구분 점선(#348). 시안 1px `#A56E85@55` · dash 1/4.

  **`shape="line"`을 쓰지 않는다** — 그쪽은 획을 뷰 세로 중앙에 그려서 높이를 정확히
  주지 않으면 어디에 걸릴지 흔들린다. 위 테두리만 있는 사각형으로 그려 뷰 높이가 곧
  선 위치가 되게 한다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="@dimen/davi_divider_thickness"
        android:color="@color/davi_divider_dash"
        android:dashWidth="@dimen/davi_divider_dash_on"
        android:dashGap="@dimen/davi_divider_dash_off" />
</shape>
