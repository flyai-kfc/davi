<?xml version="1.0" encoding="utf-8"?>
<!--
  종료 X의 흰 곡면(v2, #178). 시안 지름 68 · `#FFFFFF` 96%.

  **창 밖에 뜬 별개 요소가 아니다** — 창의 오른쪽 위 모서리가 안으로 파이고 그 자리에
  이 곡면이 앉아 창과 한 덩어리로 읽힌다. 구 버전의 사각 "X 그만 볼래요" 칩을 대체한다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/davi_overlay_close_face" />
        </shape>
    </item>
</ripple>
