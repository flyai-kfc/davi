<?xml version="1.0" encoding="utf-8"?>
<!--
  카카오 로그인 버튼 배경(button/oauth-kakao). **밝은 채움이라 눌림은 검정 12%**다(#246, E2).

  시안 `v2/button/kakao` 240x60 r12 · 채움 #FEE500 · 테두리 없음 ·
  그림자 #000000 @30% y3 blur4 (#266).

  그림자는 blur 없는 근사다(단색 도형을 아래로 민다) — ON-2 버튼·카드와 같은 사정이다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed_on_light">
    <item>
        <layer-list>
            <item
                android:top="@dimen/davi_onboarding_button_shadow_y"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_onboarding_button_shadow" />
                    <corners android:radius="@dimen/davi_radius_md" />
                </shape>
            </item>
            <item android:bottom="@dimen/davi_onboarding_button_shadow_y">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_button_kakao" />
                    <corners android:radius="@dimen/davi_radius_md" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
