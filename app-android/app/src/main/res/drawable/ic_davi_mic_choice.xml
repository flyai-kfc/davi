<?xml version="1.0" encoding="utf-8"?>
<!--
  MA-3 「직접 말하기」 아이콘 슬롯 속 마이크(#374). 시안 18x25 `color/highlight`.

  **ic_davi_mic을 줄여 쓰지 않는다.** 그쪽은 뷰포트 76에 그릴 두 줄과 그라디언트 캡슐까지
  들어간 91dp 전용 글리프라, 22dp로 줄이면 획이 1dp 밑으로 내려가 뭉개진다.
  여기서는 같은 형태를 획 하나로 단순화해 다시 그렸다.

  **뷰포트는 렌더 크기와 1:1이다**(21.6x30) — 다르면 획이 따라 늘어난다.
  크기 18x25는 객체라 x1.2다. **획 굵기는 시안에 없어 저장소의 선 굵기 2dp를 따른다**
  (davi_confirm_choice_stroke·셰브런과 같다).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="21.6dp"
    android:height="30dp"
    android:viewportWidth="21.6"
    android:viewportHeight="30">
    <!-- 몸통 캡슐 -->
    <path
        android:pathData="M10.8,2 A4,4 0 0 1 14.8,6 L14.8,14 A4,4 0 0 1 6.8,14 L6.8,6 A4,4 0 0 1 10.8,2 Z"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />
    <!-- 받침 U -->
    <path
        android:pathData="M3.8,13 C3.8,23 17.8,23 17.8,13"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- 대 -->
    <path
        android:pathData="M10.8,21 L10.8,27"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
