<?xml version="1.0" encoding="utf-8"?>
<!--
  MA-4 확인 버튼 (1)(2) 배경(#348). 흰 채움 + `color/button/primary` 테두리 w2 · r12.

  **그림자가 없다**(2026-08-21 판정). 걷어낸 캡슐쌍에는 있었고 E2가 상시 elevation 2dp를
  말하지만, 여기서는 테두리가 경계를 지고 채움이 배경과 갈린다 — 그림자까지 얹으면 셋이
  나란히 떠 보여 「무엇을 눌러야 하나」가 흐려진다.

  **채워진 주 버튼을 만들지 않는다.** 최종 확인은 우리가 권하는 자리가 아니라 사용자가
  고르는 자리라, #A50014 채움(= 권하는 동작)을 쓰면 그쪽을 누르라는 화면이 된다.

  테두리는 시안 INSIDE 2인데 Android <stroke>는 경계선 중앙 정렬이라 1dp가 밖으로 나간다 —
  보정 복잡도에 비해 얻는 게 작아 그대로 둔다(bg_davi_stacked_secondary와 같은 사정).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed_on_light">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/davi_surface_raised" />
            <stroke
                android:width="@dimen/davi_confirm_choice_stroke"
                android:color="@color/davi_button_primary" />
            <corners android:radius="@dimen/davi_confirm_choice_radius" />
        </shape>
    </item>
</ripple>
