<?xml version="1.0" encoding="utf-8"?>
<!--
  보조 버튼 배경: 서피스 + 테두리. **밝은 채움이라 눌림은 검정 12%**다(#246, E2).

  시안 `v2/button` type=secondary 240x60 r12 · 채움 #F4F4F6 · 테두리 #D9D9D9 1.5 ·
  카카오와 같은 그림자 (#266).
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/davi_state_layer_pressed_on_light">
    <item>
        <layer-list>
            <item
                android:top="@dimen/davi_onboarding_button_shadow_y"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_onboarding_button_shadow" />
                    <corners android:radius="@dimen/davi_radius_md" />
                </shape>
            </item>
            <item android:bottom="@dimen/davi_onboarding_button_shadow_y">
                <shape android:shape="rectangle">
                    <solid android:color="@color/davi_surface" />
                    <stroke android:width="@dimen/davi_button_stroke" android:color="@color/davi_border" />
                    <corners android:radius="@dimen/davi_radius_md" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
