<?xml version="1.0" encoding="utf-8"?>
<!--
  마이크 아이콘 (v2, #172) — Figma `v2/button/mic` > `기본` 에서 추출.
  뷰포트 76×76 은 시안 프레임(300×620) 기준 마이크 버튼 지름과 같다.
  실기기 크기는 @dimen/davi_mic_button_size (91dp).

  **E3(Lucide 24 그리드)의 예외다.** 마이크는 이 앱의 유일한 주 조작 수단이고 시안이
  전용으로 그린 글리프라, 24 그리드로 다시 그리면 시안 대응(76 -> 91dp)이 깨진다.

  이 파일에는 아이콘 6-path 만 있다. 흰 원과 뒤쪽 빨강 글로우는 배경 레이어라
  여기 넣지 않는다 (bg_davi_mic_button · MicGlowView).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="76dp"
    android:height="76dp"
    android:viewportWidth="76"
    android:viewportHeight="76">

    <!--
      1. 마이크 몸통 — 캡슐. 채움은 세로 2톤(50/51% 하드 스플릿), 테두리 4.

      **Figma에서 테두리가 INSIDE 정렬**인데 VectorDrawable의 stroke는 중앙 정렬이라,
      사각형을 굵기의 절반(2)만큼 안으로 넣었다 — 시안 x28 y9 w20 h36 반경 10이
      여기서는 x30 y11 w16 h32 반경 8이다. 바깥 경계는 시안과 같은 x28~48 / y9~45.

      그라디언트 범위는 안쪽 path가 아니라 **바깥 캡슐 경계(y9~45)** 기준이다.
      **offset을 뭉개면 안 된다** — 부드러운 그라디언트가 아니라 딱 반으로 갈리는 형태다.
    -->
    <path
        android:pathData="M30,19 A8,8 0 0 1 46,19 L46,35 A8,8 0 0 1 30,35 Z"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="4"
        android:strokeLineJoin="miter">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38" android:startY="9"
                android:endX="38"   android:endY="45">
                <item android:offset="0.0"  android:color="@color/davi_surface_secondary" />
                <item android:offset="0.5"  android:color="@color/davi_surface_secondary" />
                <item android:offset="0.51" android:color="@color/davi_mic_capsule_bottom" />
                <item android:offset="1.0"  android:color="@color/davi_mic_capsule_bottom" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2·3. 그릴 두 줄 — 여기만 굵기 3 -->
    <path
        android:pathData="M32,16 L44,16"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M32,24 L44,24"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- 4. 받침 — U자 곡선. 채움 없음 -->
    <path
        android:pathData="M21,32 C21,54 55,54 55,32"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- 5. 대 -->
    <path
        android:pathData="M38,50 L38,59"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- 6. 바닥 -->
    <path
        android:pathData="M29,60 L47,60"
        android:strokeColor="@color/davi_highlight"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
