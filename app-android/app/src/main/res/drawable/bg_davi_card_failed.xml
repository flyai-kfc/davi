<?xml version="1.0" encoding="utf-8"?>
<!--
  실패 화면 카드(메인 8, #208). `bg_davi_card_speaking`과 구조가 같고 **채움만 불투명**이다.

  **왜 글라스가 아닌가** — 이 화면만 카드가 캐릭터 하단을 53dp 파고든다. 글라스로 두면
  그 구간에서 캐릭터의 검은 몸통이 비쳐 보인다(실기기 실측). 다른 화면은 카드 뒤가 분홍
  배경뿐이라 이 문제가 없다.

  채움 값의 근거는 colors.xml의 davi_card_failed_* 주석에 있다 — 지금 렌더된 카드 픽셀에서
  뽑아서 **배경 위에서는 글라스와 같아 보인다.**

  분홍 글로우는 여기 없다. 카드 뒤 CardGlowView가 그린다(#170).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:top="@dimen/davi_card_shadow_offset_y_speaking"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/davi_card_shadow_speaking" />
            <corners android:radius="@dimen/davi_radius_xl" />
        </shape>
    </item>

    <!-- 불투명 채움 + 테두리. 글라스 + 틴트 두 겹을 이 한 겹이 대신한다. -->
    <item android:bottom="@dimen/davi_card_shadow_offset_y_speaking">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/davi_card_failed_top"
                android:centerColor="@color/davi_card_failed_mid"
                android:endColor="@color/davi_card_failed_bottom"
                android:type="linear" />
            <stroke
                android:width="@dimen/davi_card_border_width"
                android:color="@color/davi_card_border" />
            <corners android:radius="@dimen/davi_radius_xl" />
        </shape>
    </item>

    <!-- 유리 하이라이트 — 윗변 안쪽 흰 띠. 근거는 bg_davi_card_speaking 주석. -->
    <item
        android:left="@dimen/davi_card_highlight_inset"
        android:right="@dimen/davi_card_highlight_inset"
        android:top="@dimen/davi_card_highlight_offset_y"
        android:gravity="top"
        android:height="@dimen/davi_card_highlight_height">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/davi_card_inner_highlight"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
