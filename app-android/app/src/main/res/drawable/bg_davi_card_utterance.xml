<?xml version="1.0" encoding="utf-8"?>
<!--
  시니어 발화 카드 — **불투명 그라디언트**(2026-08-17). 다비 카드와 달리 글라스가 아니다.
  **그림자는 번지지 않는다** — 같은 폭의 단색 도형을 3dp 내린 단순화다(bg_davi_card 주석 참고).
  근거는 colors.xml의 davi_card_senior_top 주석에 있다(글라스로는 배경과 ΔG +1로 안 갈렸다).
  elevation 금지 근거는 bg_davi_card와 같고 그림자는 검정 7%로 조금 더 옅다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:top="@dimen/davi_card_shadow_offset_y"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/davi_card_shadow_idle_senior" />
            <corners android:radius="@dimen/davi_radius_xl" />
        </shape>
    </item>

    <item android:bottom="@dimen/davi_card_shadow_offset_y">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/davi_card_senior_top"
                android:endColor="@color/davi_card_senior_bottom"
                android:type="linear" />
            <stroke
                android:width="@dimen/davi_card_border_width"
                android:color="@color/davi_card_border" />
            <corners android:radius="@dimen/davi_radius_xl" />
        </shape>
    </item>
</layer-list>
