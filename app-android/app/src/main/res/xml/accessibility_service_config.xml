<?xml version="1.0" encoding="utf-8"?>
<!--
  접근성 서비스 설정. 외부 앱 화면 트리를 읽기 위한 최소 구성.
  flagRetrieveInteractiveWindows: 셰이드/IME 등 다른 창 정보까지 확보(HANDOFF: 셰이드 트리·IME top 필요).
  타 제조사·구버전에서 플래그가 다르게 동작할 수 있다(SPEC §11).

  isAccessibilityTool=false: 우리는 **장애 보조 도구가 아니다**(#227). 시니어에게 사용법을
  가르치려고 화면을 읽는 것이라, 접근성 API를 그 본래 용도 밖으로 쓰는 쪽에 해당한다.
  밝히지 않으면 실제 용도와 선언이 어긋나 Play 정책에 걸린다. API 30에 추가된 속성이라
  minSdk 26의 구버전에서는 무시된다.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />
