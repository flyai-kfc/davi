<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 서버(추론 오케스트레이터) 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 안내 중 접근성이 꺼졌을 때 알릴 **유일한 수단**이다(#212). 그때 우리는 백그라운드라
         토스트는 시스템이 억제하고(#190 실측) 오버레이는 서비스와 함께 죽는다. 알림만 남고,
         **그 알림의 탭이 예전의 자동 복귀를 대신한다** — 그래서 채널이 필요하다
         (근거는 ServiceOffAction KDoc). 요청은 ConversationActivity가 한 번 한다.
         헤드업 폴백 근거는 폐기됐다(#56: 접근성 오버레이는 설정 앱 위에도 그려진다). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 사용자가 누른 동안 목표를 음성으로 입력. 원시 오디오는 앱이 저장하거나 서버로 보내지 않는다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- QUERY_ALL_PACKAGES 없이 현재 프로필에서 launcher로 실행 가능한 앱만 조회한다(#102). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 카카오톡 앱으로 로그인 가능 여부 판정(isKakaoTalkLoginAvailable, API 30+ 가시성). -->
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".DaviApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Davi"
        android:usesCleartextTraffic="false">

        <!-- 릴리스 진입점: 로그인(스킵 가능) → 개인정보 동의 → 온보딩 → 대화 화면. ON-1, docs/SCREENS.md. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          카카오 계정(웹) 로그인의 리다이렉트 수신. scheme은 빌드가 채운다.
          커스텀 scheme은 어떤 값이든 매칭되므로(#168 리뷰 P1), 키 없는 빌드는
          enabled=false로 activity 자체를 꺼서 외부 인텐트 진입점을 남기지 않는다.
        -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:enabled="${kakaoLoginEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="${kakaoOauthScheme}" />
            </intent-filter>
        </activity>

        <!--
          ON-1.5 개인정보 동의(#389). ON-1과 ON-2 사이. 진입은 LoginActivity가
          ConsentStore로 판정해 거친다 — 이미 지금 문안에 동의했으면 건너뛴다.
        -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 온보딩(권한 안내, #123). 진입은 LoginActivity를 거친다. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!--
          세로 고정: 고정 배치라 가로에서는 질문·발화 카드가 화면 밖으로 밀린다(실기기 실측).
          configChanges는 세로 고정과 함께 남긴다 — 회전 외에도 멀티윈도우·접힘 등으로
          구성이 바뀌면 재생성되고, 그때 onPause가 진행 중인 왕복을 접기 때문이다.
          fontScale·uiMode는 일부러 넣지 않는다 — 글꼴 크기·다크 전환은 재생성돼야 반영된다.
        -->
        <activity
            android:name=".ConversationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- 화면 읽기 + 안내 루프의 본체. 시스템이 이름으로 바인딩하므로 exported=true -->
        <service
            android:name=".GuideAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
