<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 서버(추론 오케스트레이터) 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 다른 앱 위 오버레이. 사용자가 설정에서 켠다(온보딩) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 설정 앱 등 오버레이 불가 화면에서 헤드업 알림 폴백(HANDOFF §3-1) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 사용자가 누른 동안 목표를 음성으로 입력. 원시 오디오는 앱이 저장하거나 서버로 보내지 않는다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Davi"
        android:usesCleartextTraffic="false">

        <!-- 릴리스 진입점: 온보딩 → 대화 화면(#123). 대화 화면은 외부 인텐트를 받지 않는다. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          configChanges: 회전으로 Activity가 재생성되면 onPause가 대화를 접어 진행 중인
          왕복이 사라진다. 화면이 고정 배치라 재생성 없이 그대로 두는 편이 맞다.
          fontScale·uiMode는 일부러 넣지 않는다 — 글꼴 크기·다크 전환은 재생성돼야 반영된다.
        -->
        <activity
            android:name=".ConversationActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />

        <!-- 화면 읽기 + 안내 루프의 본체. 시스템이 이름으로 바인딩하므로 exported=true -->
        <service
            android:name=".GuideAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
