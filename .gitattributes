# Gradle wrapper — 줄바꿈·바이너리 취급을 못박는다.
# 개발 PC는 Windows, CI는 Linux라 이 지정이 없으면 gradlew가 CRLF로 체크아웃돼
# 리눅스에서 실행되지 않는 사고가 난다.
gradlew         text eol=lf
gradlew.bat     text eol=crlf
*.jar           binary

# 셸 스크립트는 어디서 체크아웃하든 LF
*.sh            text eol=lf

# 핑퐁 시나리오 해시는 OS가 아니라 내용만 식별해야 한다.
eval/pingpong/scenarios/*.json text eol=lf

# git 훅도 셸 스크립트다. CRLF면 셔뱅(#!/bin/sh)이 깨져 실행되지 않는다.
.githooks/*     text eol=lf
